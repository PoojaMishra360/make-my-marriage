# Required when connecting Saath to MongoDB Atlas or a local MongoDB instance.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/saath?retryWrites=true&w=majority
MONGODB_DB=saath

# Public application address used in invitation and RSVP links. Use the Vercel URL in production.
APP_URL=http://localhost:3000

# Session signing secret. Use a long random value in Vercel Production.
AUTH_SECRET=replace-with-a-long-random-secret

# Configure private Cloudflare R2 before enabling uploads.
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Configure approved invitation providers before enabling delivery.
# EMAIL_PROVIDER=
# WHATSAPP_PROVIDER=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Make My Marriage <onboarding@resend.dev>
